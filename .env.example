# Server-only credentials. Never use the VITE_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set the exact public website origin when running behind an HTTPS reverse proxy.
# CHAT_ALLOWED_ORIGIN=https://your-domain.example

# Applications are saved on the server; email is not used.
# For production, set an absolute path on persistent storage outside dist/.
# APPLICATIONS_FILE=/persistent-data/yaazh360/applications.jsonl
# APPLICATION_ALLOWED_ORIGIN=https://your-domain.example

# Public Web3Forms form access key (not an SMTP password).
VITE_WEB3FORMS_ACCESS_KEY=

# VPS Deployment (optional, for scripts/deploy_vps.py)
VPS_HOST=93.127.195.80
VPS_USER=root
VPS_PASSWORD=your_vps_password

