# Vite fingerprints imported assets; new versions receive new URLs.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate HTML so a deployment does not leave old page-chunk URLs cached.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/services
  Cache-Control: public, max-age=0, must-revalidate
/about
  Cache-Control: public, max-age=0, must-revalidate
/work
  Cache-Control: public, max-age=0, must-revalidate
/careers
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate
/partners
  Cache-Control: public, max-age=0, must-revalidate
/brochure
  Cache-Control: public, max-age=0, must-revalidate
